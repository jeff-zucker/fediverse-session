{
  "name": "fediverse-session",
  "version": "0.2.1",
  "description": "Type a Fediverse handle or a WebID and get back an account you can act with: post, read its timeline, follow, reply, favourite, boost. Works out whether the account lives on a Mastodon-family server or on a Solid pod through FediPod, sends the person to sign in there, brings them back to where they were, and speaks to whichever it is.",
  "type": "module",
  "license": "MIT",
  "author": "Jeff Zucker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeff-zucker/fediverse-session.git"
  },
  "homepage": "https://github.com/jeff-zucker/fediverse-session#readme",
  "bugs": "https://github.com/jeff-zucker/fediverse-session/issues",
  "keywords": [
    "fediverse",
    "activitypub",
    "mastodon",
    "solid",
    "solid-oidc",
    "webid",
    "login",
    "oauth",
    "fedipod"
  ],
  "files": [
    "fedi-account.mjs",
    "fedi-login.mjs",
    "oidc-session.mjs",
    "README.md"
  ],
  "exports": {
    ".": "./fedi-account.mjs",
    "./fedi-account.mjs": "./fedi-account.mjs",
    "./fedi-login.mjs": "./fedi-login.mjs",
    "./oidc-session.mjs": "./oidc-session.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {},
  "peerDependencies": {
    "jsonld": "^9.0.0"
  },
  "peerDependenciesMeta": {
    "jsonld": {
      "optional": true
    }
  }
}
